# Environment
APP_ENV=dev

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# Application
APP_PORT=8000
DEBUG=true
DEFAULT_LOCALE=en

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

PREFIX=dev

# STT / Qwen3-ASR
QWEN_MODEL_NAME=Qwen/Qwen3-ASR-1.7B-hf
VAD_THRESHOLD=0.3
MIN_SILENCE_DURATION_MS=1000
MAX_CONCURRENT_SESSIONS=10

# LLM Gateway
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=dummy-api-key
LLM_X_API_KEY=
LLM_MODEL_TRANSCRIPT_ANALYSIS=gpt-4o-mini
LLM_MODEL_TRANSCRIPT_ANALYSIS_FALLBACK=
LLM_BASE_URL_FALLBACK=
LLM_API_KEY_FALLBACK=
LLM_X_API_KEY_FALLBACK=

# LangSmith Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=javis-base-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
